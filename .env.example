# Copie para .env e preencha. O .env NAO vai para o repositorio (publico).

# --- Cliente (expostos no bundle do navegador, por design) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Servidor (NUNCA expor; sem prefixo VITE_) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon key>"
SUPABASE_PROJECT_ID="<project-ref>"

# Chave service_role. Bypassa RLS. Nunca commitar, nunca prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Segredo dos cron hooks (/api/public/hooks/*). Gere com: openssl rand -hex 32
CRON_SECRET="<hex 64>"

# Salt para hashear IP no rate limit da consulta por CPF.
# Gere um novo, nao reaproveite: openssl rand -hex 32
IP_HASH_SALT="<hex 64>"
